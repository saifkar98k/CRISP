# =============================================================================
# CRISP 2.0 - Enterprise Cyber Risk Intelligence Platform Configuration
# Copy this file to .env and configure for your deployment environment.
# DO NOT COMMIT REAL CREDENTIALS OR SECRETS TO SOURCE CONTROL.
# =============================================================================

# Server Environment & Mode ('production' or 'development')
NODE_ENV=production
PORT=3000

# Operational Mode ('PRODUCTION' or 'DEMO')
# In PRODUCTION, synthetic simulation events are isolated from real enterprise telemetry.
CRISP_MODE=PRODUCTION

# Cryptographic Session & Token Signing Secret (Mandatory in production)
# Generate via: openssl rand -hex 32
CRISP_SESSION_SECRET=

# Database & Chroma Storage Paths
CRISP_DB_PATH=data/crisp.db
CRISP_CHROMA_DIR=data/chroma_db
CRISP_BACKUP_DIR=data/backups
CRISP_BACKUP_RETENTION=7

# Asynchronous Ingestion Queue Configuration
CRISP_QUEUE_CAPACITY=5000
CRISP_QUEUE_WORKERS=2

# Optional Distributed Queue Scale-Out (Redis Streams)
# Leave blank to use default high-performance in-memory bounded queue with SQLite DLQ
REDIS_URL=

# =============================================================================
# External Intelligence & AI Provider Configurations (Optional)
# =============================================================================

# National Vulnerability Database (NVD) API Key for elevated query rate limits
NVD_API_KEY=

# Groq Cloud API Key for AI Security Assistant & Multi-Agent Swarm
# If omitted, swarm automatically operates in high-performance deterministic mode
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile

# =============================================================================
# Enterprise Telemetry Adapters (Optional)
# =============================================================================

# Splunk SIEM Integration (HTTP Event Collector)
SPLUNK_HEC_URL=
SPLUNK_HEC_TOKEN=

# CrowdStrike Falcon EDR Integration
FALCON_CLIENT_ID=
FALCON_CLIENT_SECRET=

# Custom path to raw historical security event CSV dataset (optional)
SECURITY_DATASET_PATH=